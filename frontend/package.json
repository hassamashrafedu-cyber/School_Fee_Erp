{
  "name": "account-management-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "FEE ERP — school fee management desktop application",
  "homepage": ".",
  "main": "electron-main.cjs",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "node node_modules/electron/install.js",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:prod": "npm run build && electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "pack:clean": "node scripts/prepack-cleanup.cjs",
    "pack:verify": "node scripts/verify-packaging.cjs",
    "pack:verify-out": "node scripts/verify-packaged-main.cjs",
    "predist": "node scripts/prepack-cleanup.cjs && node scripts/stage-backend.cjs && node scripts/verify-packaging.cjs",
    "predist:dir": "node scripts/prepack-cleanup.cjs && node scripts/stage-backend.cjs && node scripts/verify-packaging.cjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "postdist": "node scripts/verify-packaged-main.cjs",
    "postdist:dir": "node scripts/verify-packaged-main.cjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
