# Copy to .env before running the ERP (desktop installer: resources/backend/.env)
PORT=5000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=school_management_db
DB_PASSWORD=your_password_here
DB_PORT=5432
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Optional: passwords used only when Admin/Accountant users are first created
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ACCOUNTANT_PASSWORD=accountant123

# WhatsApp Cloud API (Meta) — never put these in frontend
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_NAME=fee_pending_reminder
# Must match Meta exactly (often en or en_US)
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
# Locked template shape:
# Header {{1}} = school_name | Body {{1}} = student_name | Body {{2}} = amount
WHATSAPP_BODY_VARS=student_name,amount
WHATSAPP_HEADER_VAR=school_name
WHATSAPP_SEND_DELAY_MS=350
